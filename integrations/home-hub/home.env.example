# Copy to integrations/home-hub/home.env (gitignored)

HOME_HUB_PORT=3088
LINUX_STUDEX_URL=http://127.0.0.1:4000

# Samsung (Tizen) — Settings → General → External Device Manager → Device Connection Manager → Access Notification → allow, then first pairing stores token
SAMSUNG_TV_IP=192.168.1.50
# SAMSUNG_TV_TOKEN=
# SAMSUNG_TV_NAME=StudexLounge

# JVC — often CEC on Linux hub connected to same AVR/HDMI chain
JVC_HDMI_PORT=1
# JVC_IR_BRIDGE_URL=http://192.168.1.60/ir/send

# Apple TV (pyatv) — pair once: atvremote scan, then atvremote --protocol companion pair
APPLE_TV_HOST=192.168.1.55
# APPLE_TV_IDENTIFIER=AA:BB:CC:DD:EE:FF
# APPLE_TV_CREDENTIALS=/Users/tumeloramaphosa/.studex/apple_tv.conf
# Or Home Assistant media_player entity for Apple TV:
# APPLE_TV_HA_ENTITY=media_player.lounge_apple_tv

# Apple devices on the Mac hub (Shortcuts + AppleScript)
# Create a Shortcut named "Studex Home Scene" on iPhone/Mac, or run by name:
APPLE_SHORTCUT_HOME=Studex Home
# Optional Home Assistant for HomeKit cameras + Apple TV in one API:
# HOME_ASSISTANT_URL=http://192.168.1.10:8123
# HOME_ASSISTANT_TOKEN=

# Cameras — copy cameras.example.json → cameras.json (gitignored)
CAMERAS_JSON=integrations/home-hub/cameras.json

# Phonon (optional)
PHONON_MODEL_ID=gradium/phonon-31m-en
PHONON_ENABLED=false
