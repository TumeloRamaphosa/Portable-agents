# Copy to integrations/home-hub/home.env (gitignored)

HOME_HUB_PORT=3088
LINUX_STUDEX_URL=http://127.0.0.1:4000

# Samsung (Tizen) — Settings → General → External Device Manager → Device Connection Manager → Access Notification → allow, then first pairing stores token
SAMSUNG_TV_IP=192.168.1.50
# SAMSUNG_TV_TOKEN=
# SAMSUNG_TV_NAME=StudexLounge

# JVC — often CEC on Linux hub connected to same AVR/HDMI chain
JVC_HDMI_PORT=1
# JVC_IR_BRIDGE_URL=http://192.168.1.60/ir/send

# Phonon (optional)
PHONON_MODEL_ID=gradium/phonon-31m-en
PHONON_ENABLED=false
