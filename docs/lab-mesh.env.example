# Copy to docs/lab-mesh.env (gitignored) and fill in. No secrets in this file.

# Paperclip / ClickClack hub (Mac Mini recommended)
PAPERCLIP_URL=http://macmini:3100
# PAPERCLIP_URL=http://100.x.x.x:3100

# Tailscale MagicDNS names (optional checks)
LAB_HOST_MACMIN=macmini
LAB_HOST_MACBOOK=macbook-pro
LAB_HOST_MSI=msi-gpu
LAB_HOST_LENOVO=lenovo-lab

# Local Gitea (Mac Mini or Lenovo)
GITEA_URL=http://macmini:3000/studex/Portable-agents.git

# Agent deliverables → Google Drive (Studex Lenovo folder)
GDRIVE_ARCHIVE_FOLDER_ID=16Ke46oCGb_Xd0CmlL9bjDtXEvgmKsEmR
STUDEX_ARCHIVE_ROOT=~/.studex/archive
# GDRIVE_RCLONE_REMOTE=gdrive
# GDRIVE_RCLONE_PATH=Lenovo/studex-archive

# LAN fallback (home network)
LAB_LAN_MSI=192.168.1.114

# Hermes gateway ports (loopback + tailscale serve)
HERMES_GATEWAY_PORT=8642

# Buzz (buzz.xyz) on MSI — relay WebSocket or HTTP base URL
# BUZZ_RELAY_URL=http://macmini:3000
# MSI_BUZZ_AGENT_NAME=Studex-MSI

# Obsidian / AutoMeat (Mac paths — adjust username if needed)
AUTOMEAT_VAULT_PATH=/Users/tumeloramaphosa/Documents/Obsidian Vault/Auto-Meat
# Herdr Bridge plugin folder inside vault (relative): herdr/
# HERDR_SOCKET_PATH=~/.config/herdr/herdr.sock
# Copy checklist templates: integrations/obsidian-herdr/*.md.example → vault/herdr/
