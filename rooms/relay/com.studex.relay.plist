<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS: edit the four values, copy to ~/Library/LaunchAgents/, then
     launchctl load ~/Library/LaunchAgents/com.studex.relay.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.studex.relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/YOU/studex_relay.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>STUDEX_GATEWAY</key><string>https://YOUR-GATEWAY</string>
    <key>STUDEX_COMPUTER</key><string>coffee-desk</string>
    <key>STUDEX_RELAY_TOKEN</key><string>PASTE-TOKEN</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/studex-relay.log</string>
  <key>StandardErrorPath</key><string>/tmp/studex-relay.log</string>
</dict>
</plist>
