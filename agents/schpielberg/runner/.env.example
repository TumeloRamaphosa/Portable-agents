# Studex content pipeline runner — placeholders only.
# chmod 600. Fill real values later through the secure box. Never commit keys.
# This runner is dry-run by default: no posts, no sends, no paid generation APIs.

# Dashboard API (bearer). Leave empty until the Content Pipeline API is live.
PIPELINE_API_BASE=
PIPELINE_API_TOKEN=
PIPELINE_HEARTBEAT_PATH=/api/pipeline/heartbeat
PIPELINE_QUEUE_PATH=/api/pipeline/queue
PIPELINE_ITEMS_PATH=/api/pipeline/items
PIPELINE_POLL_SECONDS=60
PIPELINE_RUNNER_ID=naledi-cmo
PIPELINE_DRY_RUN=true

# Script step (OpenAI-compatible Gemini endpoint). Leave empty = not configured.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash

# Voice step. Leave empty = not configured. Do not spend until approved.
VOICE_PROVIDER=
ELEVENLABS_API_KEY=

# Pictures step. Local ComfyUI only when a URL is set. Leave empty = not configured.
PICTURES_PROVIDER=
COMFYUI_URL=
